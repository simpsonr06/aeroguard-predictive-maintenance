# ==============================================================================
# AeroGuard 2.0 / 2.1 — Environment Configuration Template
# Copy this file to .env for local Docker or bare-metal environment overrides.
# ==============================================================================

# Backend Service Configuration
API_HOST=0.0.0.0
API_PORT=8000
PYTHONPATH=src
LOG_LEVEL=info

# Frontend Service Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Client-side API URL (Accessed by user browsers)
NUXT_PUBLIC_API_BASE=http://localhost:8000

# Server-side Internal API URL (Used by Nuxt Nitro server in Docker network)
BACKEND_URL=http://backend:8000
